# 새 키 이름은 _API_KEY나 _AUTH_TOKEN으로 끝나야 로그·오류에서 값이 가려진다.
# 필수: Claude API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# 선택: 영상 공급자. flow(기본, 작업 화면에서 장면 클립을 직접 올림) | stock(Pixabay·Pexels 자동 검색, 아래 키 필요)
SP_VIDEO=
# 선택: Pixabay 무료 키 (https://pixabay.com/api/docs/ 에 로그인하면 보인다). SP_VIDEO=stock일 때 필요.
PIXABAY_API_KEY=
# 선택: Pexels 키. SP_VIDEO=stock일 때 필요. 2026-10부터 새 키 발급이 멈췄다. 둘 다 있으면 Pexels를 먼저 쓴다.
PEXELS_API_KEY=
# 선택: 채널 분야. 대본과 추천 주제가 이 분야 안에서 돈다. 비우면 기본값 '사람들에게 실제로 도움이 되는 상식'
SP_CHANNEL=
# 선택: 대본 모델. 기본 claude-opus-5-5, 싸게 돌리려면 claude-sonnet-5-5 또는 claude-haiku-4-5
CLAUDE_MODEL=
# 선택: ElevenLabs 유료 목소리(자막이 낱말 시각에 맞는다). 키는 elevenlabs.io → Developers → API Keys,
# 목소리 ID는 Voice Library에서 한국어 목소리를 My Voices에 추가한 뒤 ID 복사(기본 목소리). 키만 있으면 켜지고, 고를 목소리는 voice.ElevenLabs.voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 선택: 기본 eleven_multilingual_v2(1글자=1크레딧). 싸게 하려면 eleven_flash_v2_5(0.5크레딧)
ELEVENLABS_MODEL=
# 선택: YouTube 비공개 업로드. Google Cloud → YouTube Data API v3 사용 → OAuth 클라이언트 '데스크톱 앱' JSON을 받아 그 경로를 넣는다.
# 넣은 뒤 터미널에서 uv run sp youtube-login을 한 번 한다.
YOUTUBE_CLIENT_SECRET=
# 선택: 주제 찾기(인기 쇼츠 수집). Google Cloud 콘솔 → YouTube Data API v3 사용 설정 → 사용자 인증 정보 → API 키.
# 무료, 하루 10,000유닛(분석 한 번에 약 101유닛). 업로드용 YOUTUBE_CLIENT_SECRET과는 별개다.
YOUTUBE_API_KEY=
# 선택: libass가 들어간 ffmpeg 경로 (기본 /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg)
SP_FFMPEG=
# 선택: tailscale serve 등으로 열 때 받을 호스트 이름(쉼표로 여러 개). 예: macmini.tailnet.ts.net
SP_HOSTS=
