# 새 키 이름은 _API_KEY·_TOKEN·_WEBHOOK_URL로 끝나야 로그·오류에서 값이 가려진다.
# 필수: Claude API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# 선택: 대시보드에 Claude 남은 크레딧. API에 잔액 조회가 없어 Console 잔액을 한 번 적어 두고 그날부터 쓴 돈을 뺀다.
# Admin 키는 Console → Settings → Admin Keys(조직 계정만). 잔액은 Console → Billing의 Credit balance, 날짜는 적은 날(YYYY-MM-DD)
ANTHROPIC_ADMIN_API_KEY=
CLAUDE_CREDIT_USD=
CLAUDE_CREDIT_SINCE=
# 영상 공급자·채널 분야·목소리는 채널마다 channels/<id>/channel.toml에서 고른다.
# 선택: ElevenLabs 유료 목소리(자막이 낱말 시각에 맞는다). 키는 elevenlabs.io → Developers → API Keys,
# 목소리 ID는 Voice Library에서 한국어 목소리를 My Voices에 추가한 뒤 ID 복사(기본 목소리). 키만 있으면 켜지고, 고를 목소리는 channel.toml [tts.voices].
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 선택: 기본 eleven_multilingual_v2(1글자=1크레딧). 싸게 하려면 eleven_flash_v2_5(0.5크레딧)
ELEVENLABS_MODEL=
# 선택: Typecast 유료 목소리(1글자=1크레딧, 자막이 낱말 시각에 맞는다). 키는 typecast.ai → API 콘솔 → API Keys.
# 채널에서 쓰려면 channel.toml [tts] provider = "typecast", [tts.voices]에 목소리 ID(tc_…)를 넣는다.
TYPECAST_API_KEY=
# 선택: 기본 ssfm-v30. 이전 모델은 ssfm-v21
TYPECAST_MODEL=
# 선택: Fish Audio Drama 3 목소리(자막은 글자 수 비례). 키는 fish.audio → API Keys.
# 채널에서 쓰려면 channel.toml [tts] provider = "fish", [tts.voices]에 Voice Library 목소리 ID를 넣는다.
FISH_AUDIO_API_KEY=
# 선택: YouTube 비공개 업로드. Google Cloud → YouTube Data API v3 사용 → OAuth 클라이언트 '데스크톱 앱' JSON을 받아 그 경로를 넣는다.
# 넣은 뒤 터미널에서 채널마다 uv run sp youtube-login --channel <id>를 한 번 한다.
YOUTUBE_CLIENT_SECRET=
# 선택: 주제 찾기 [인기 쇼츠 참고]. Google Cloud → YouTube Data API v3 사용 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=
# 선택: libass가 들어간 ffmpeg 경로 (기본 /opt/homebrew/opt/ffmpeg-full/bin/ffmpeg)
SP_FFMPEG=
# 선택: tailscale serve 등으로 열 때 받을 호스트 이름(쉼표로 여러 개). 예: macmini.tailnet.ts.net
SP_HOSTS=
# 선택: 스케줄 알림(업로드 완료·실패·민감 대본 확인 대기). 넣은 것 모두로 보낸다.
# Discord: 서버 설정 → 연동 → 웹후크 → 새 웹후크 → 알림 받을 채널 고르기 → 웹후크 URL 복사
DISCORD_WEBHOOK_URL=
# Telegram: @BotFather에게 /newbot → 받은 토큰. 만든 봇에게 아무 말이나 보낸 뒤
# https://api.telegram.org/bot<토큰>/getUpdates 를 열어 "chat":{"id":…} 값을 CHAT_ID에 넣는다
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 선택: 알림 속 작업 링크 주소(기본 http://127.0.0.1:8765). tailscale serve면 https://machine.tailnet.ts.net
SP_URL=
